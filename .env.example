# ─── General ───────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3001
SERVER_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ─── Database (Neon PostgreSQL) ────────────────────
DATABASE_URL=postgresql://user:password@host:5432/callo?sslmode=require

# ─── Clerk Authentication ─────────────────────────
# Get from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Web app (Next.js) env vars:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Vapi (AI Voice) ──────────────────────────────
# Get from https://dashboard.vapi.ai
VAPI_API_KEY=vapi_...
VAPI_WEBHOOK_SECRET=...

# ─── Stripe (Payments) ────────────────────────────
# Get from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...

# ─── Google Calendar ──────────────────────────────
# Get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# ─── Cloudflare R2 (Storage) ─────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=callo-recordings
R2_PUBLIC_URL=https://recordings.callo.ai

# ─── Expo (Push Notifications) ───────────────────
EXPO_ACCESS_TOKEN=...

# ─── Sentry (Error Tracking) ─────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ─── Web App ─────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
